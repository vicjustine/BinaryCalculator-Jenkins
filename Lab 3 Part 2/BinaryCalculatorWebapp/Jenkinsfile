pipeline {
  agent any

  tools {
    maven 'maven'
  }

  stages {

    stage('Init') {
      steps {
        sh 'echo "Start of Job"'
        sh 'ls -la'
      }
    }

    stage('test') {
      steps {
        sh 'mvn clean test -f "./Lab 3 Part 2/BinaryCalculatorWebapp/pom.xml"'
      }
    }

    stage('build') {
      steps {
        sh 'mvn package -DskipTests -f "./Lab 3 Part 2/BinaryCalculatorWebapp/pom.xml"'
      }
    }

    stage('Deploy') {
      steps {
        sh 'echo "Deployment stage placeholder"'
      }
    }
  }
}
